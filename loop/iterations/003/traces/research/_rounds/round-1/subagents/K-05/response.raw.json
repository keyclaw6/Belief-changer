s://www.ncbi.nlm.nih.gov/pubmed/28775179\n- https://www.latimes.com/nation/nationnow/la-na-pol-medicare-finances-20180605-story.html\n- https://scholar.google.com/scholar_lookup?title=The+global+burden+of+chronic+diseases:+Overcoming+impediments+to+prevention+and+control&author=Yach,+D.&author=Hawkes,+C.&author=Gould,+C.L.&author=Hofman,+K.J.&publication_year=2004&journal=JAMA&volume=291&pages=2616%E2%80%932622&doi=10.1001/jama.291.21.2616\n- https://doi.org/10.1001/jama.291.21.2616\n- https://scholar.google.com/scholar_lookup?title=Prevention+and+control+of+non-communicable+diseases&author=U.N.+General+Assembly&publication_year=2010\n- https://scholar.google.com/scholar_lookup?title=Monitoring+the+Future+National+Survey+Results+on+Drug+Use+1975%E2%80%932018:+Overview,+Key+Findings+on+Adolescent+Drug+Use&author=Johnston,+L.D.&author=Miech,+R.A.&author=O%E2%80%99Malley,+P.M.&author=Bachman,+J.G.&author=Schulenberg,+J.E.&author=Patrick,+M.E.&publication_year=2019\n- https://scholar.google.com/scholar_lookup?title=International+control+of+alcohol:+Alternative+paths+forward&author=Room,+R.&publication_year=2006&journal=Drug+Alcohol+Rev.&volume=25&pages=581%E2%80%93595&doi=10.1080/09595230600944503\n- https://doi.org/10.1080/09595230600944503\n- https://scholar.google.com/scholar_lookup?title=Alcohol+and+public+health&author=Room,+R.&author=Babor,+T.&author=Rehm,+J.&publication_year=2005&journal=Lancet&volume=365&pages=519%E2%80%93530&doi=10.1016/S0140-6736(05)17870-2\n- https://doi.org/10.1016/S0140-6736(05)17870-2\n- https://scholar.google.com/scholar_lookup?title=International+regulation+of+alcohol&author=Room,+R.&author=Schmidt,+L.A.&author=Rehm,+J.&author=M%C3%A4kela,+P.&publication_year=2008&journal=Br.+Med.+J.&volume=337&pages=a2364&doi=10.1136/bmj.a2364\n- https://doi.org/10.1136/bmj.a2364\n- https://scholar.google.com/scholar_lookup?title=Sickeningly+sweet:+Does+sugar+cause+diabetes?+Yes&author=Lustig,+R.H.&publication_year=2016&journal=Can.+J.+Diabetes&volume=40&pages=282%E2%80%93287&doi=10.1016/j.jcjd.2016.01.004\n- https://doi.org/10.1016/j.jcjd.2016.01.004\n- https://scholar.google.com/scholar_lookup?title=The+relationship+of+sugar+to+population-level+diabetes+prevalence:+An+econometric+analysis+of+repeated+cross-sectional+data&author=Basu,+S.&author=Yoffe,+P.&author=Hills,+N.&author=Lustig,+R.H.&publication_year=2013&journal=PLoS+ONE&volume=8&pages=e57873&doi=10.1371/journal.pone.0057873&pmid=23460912\n- https://doi.org/10.1371/journal.pone.0057873\n- https://www.ncbi.nlm.nih.gov/pubmed/23460912\n- https://scholar.google.com/scholar_lookup?title=The+state+of+global+health+in+2014&author=Sep%C3%BAlveda,+J.&author=Murray,+C.&publication_year=2014&journal=Science&volume=345&pages=1275%E2%80%931278&doi=10.1126/science.1257099\n- https://doi.org/10.1126/science.1257099\n- https://scholar.google.com/scholar_lookup?title=Obesity,+fat+distribution,+and+weight+gain+as+risk+factors+for+clinical+diabetes+in+men&author=Chan,+J.M.&author=Rimm,+E.B.&author=Colditz,+G.A.&author=Stampfer,+M.J.&author=Willett,+W.C.&publication_year=1994&journal=Diabetes+Care&volume=17&pages=961%E2%80%93969&doi=10.2337/diacare.17.9.961\n- https://doi.org/10.2337/diacare.17.9.961\n- https://scholar.google.com/scholar_lookup?title=Use+of+metabolic+markers+to+identify+overweight+individuals+who+are+insulin+resistant&author=McLaughlin,+T.&author=Abbasi,+F.&author=Cheal,+K.&author=Chu,+J.&author=Lamendola,+C.&author=Reaven,+G.M.&publication_year=2003&journal=Ann.+Int.+Med.&volume=139&pages=802%E2%80%93809&doi=10.7326/0003-4819-139-10-200311180-00007\n- https://doi.org/10.7326/0003-4819-139-10-200311180-00007\n- https://scholar.google.com/scholar_lookup?title=Phenotypic+characterization+of+insulin-resistant+and+insulin-sensitive+obesity&author=Chen,+D.L.&author=Liess,+C.&author=Poljak,+A.&author=Xu,+A.&author=Zhang,+J.&author=Thoma,+C.&author=Trenell,+M.&author=Milner,+B.&author=Jenkins,+A.B.&author=Chisholm,+D.J.&author=et+al.&publication_year=2015&journal=