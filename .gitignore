# Experiments retain compact verdict/change records in Git, not intermediate outputs.
/loop/iterations/*/*/
/loop/preflight/
/calibration/runs/*/*/

# Completed campaigns retain compact records; large active evidence is local or external.
/runs/
/experiments/
/loop/preflight/*/
/loop/iterations/*/traces/
/loop/iterations/*/replicate-*/
/loop/iterations/*/quit-*/
/production-books/*/research/_rounds/
ARCHIVE-MANIFEST.json

# Runtime outer-learning cycle records are sealed state, not source code.
/factory-learning/
