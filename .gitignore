# Code intelligence graph cache (codebase-memory-mcp) — never commit.
.codebase-memory-mcp/

# Local Sentinel/orchestrator recovery state; never repository truth.
/memory.md
*.cbm-graph/
.codex/


# OS / editor cruft.
.DS_Store
*.swp
*~

# Calibration reference text (calibration/reference/gsbs/) is committed: the
# source EPUB is already in-repo and the loop must run from a fresh clone.

# Python bytecode from running the eval suite.
__pycache__/
*.pyc



# dotenvx private keys stay outside Git; encrypted .env files are tracked.
.env.keys
.env.keys.*
.loop-work/

# pi-goal-x runtime objectives (session-local; never repository truth).
.pi/goals/
.pi/npm/
.opencode/goals/

# Loop runner noise — never campaign truth.
loop/iterations/*/hypothesizer-input.md
loop/iterations/*/*.err
loop/iterations/*/judge-*.log
loop/iterations/*/write-*.log
loop/iterations/*/factory-*.log


# v2: credentials are local-only; examples are distributable.
.env
.env.*
!.env.example
dist/

# Research accounts and transient browser artifacts are local only.
venv/
browser-profile/
browser-profiles/
profile/
research-runtime/
.agent-reach/
.opencli/
extensions/
cookies.json
Cookies
Login Data
Local State
storage-state.json
credential.json
